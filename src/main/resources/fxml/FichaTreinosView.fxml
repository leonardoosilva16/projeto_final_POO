<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.frontend.controller.FichaTreinoController" prefWidth="700" prefHeight="400">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <Label text="Fichas de Treino" style="-fx-font-size: 18;"/>
            <HBox spacing="8">
                <Label text="Membro:"/>
                <ComboBox fx:id="cbMembros" HBox.hgrow="ALWAYS"/>
                <Label text="Tipo:"/>
                <ChoiceBox fx:id="choiceTipo"/>
                <Button text="Gerar" onAction="#onGerar" fx:id="btnGerar"/>
            </HBox>
            <TextArea fx:id="outputArea" prefHeight="300" editable="false"/>
        </VBox>
    </children>
</AnchorPane>

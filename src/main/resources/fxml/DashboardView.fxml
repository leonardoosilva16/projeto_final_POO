<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.academia.frontend.controller.DashboardController">

    <left>
        <VBox spacing="10" prefWidth="200" style="-fx-background-color: #333; -fx-padding: 15;">
            <Label text="Academia" style="-fx-text-fill: white; -fx-font-size: 18;"/>
            <Button text="Membros" onAction="#showMembros" maxWidth="Infinity"/>
            <Button text="Instrutores" onAction="#showInstrutores" maxWidth="Infinity"/>
            <Button text="Planos" onAction="#showPlanos" maxWidth="Infinity"/>
            <Button text="Matrículas" onAction="#showMatriculas" maxWidth="Infinity"/>
            <Button text="Fichas" onAction="#showFicha" maxWidth="Infinity"/>
            <Button text="Catraca" onAction="#showCatraca" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentArea"/>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.frontend.controller.AlunosController"
            prefWidth="700" prefHeight="500" style="-fx-padding: 10;">
    <VBox spacing="8" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <HBox spacing="8">
            <Label text="Membros" style="-fx-font-size: 18;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Novo" onAction="#onNovo"/>
            <Button text="Editar" onAction="#onEditar"/>
            <Button text="Remover" onAction="#onRemover"/>
        </HBox>
        <TableView fx:id="tableAlunos" prefHeight="380">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" prefWidth="260"/>
                <TableColumn fx:id="colCpf" text="CPF" prefWidth="180"/>
                <TableColumn fx:id="colPlano" text="Plano" prefWidth="220"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>

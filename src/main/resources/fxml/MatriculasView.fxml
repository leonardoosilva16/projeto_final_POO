<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.frontend.controller.MatriculasController" prefWidth="700" prefHeight="400">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <Label text="Matrículas" style="-fx-font-size: 18;"/>
            <HBox spacing="8">
                <Label text="Membro:"/>
                <ComboBox fx:id="cbMembros" HBox.hgrow="ALWAYS"/>
                <Label text="Plano:"/>
                <ComboBox fx:id="cbPlanos" prefWidth="220"/>
            </HBox>
            <HBox spacing="8">
                <Button text="Vincular" fx:id="btnVincular" onAction="#onVincular"/>
                <Button text="Renovar" fx:id="btnRenovar" onAction="#onRenovar"/>
            </HBox>
            <TextArea fx:id="outputArea" prefHeight="250" editable="false"/>
        </VBox>
    </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.academia.controller.InstrutoresController">
    <children>
        <SplitPane dividerPositions="0.4" layoutX="10.0" layoutY="10.0" prefHeight="600.0" prefWidth="900.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <children>
                                <Label text="Instrutores">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tabelaInstrutores" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="btnRemoverInstrutor" mnemonicParsing="false" onAction="#handleRemoverInstrutor" text="Excluir Instrutor" disable="true" style="-fx-background-color: #ffcccc; -fx-text-fill: red; -fx-border-color: red; -fx-border-radius: 3;" />
                                    </children>
                                </HBox>

                                <Label text="Novo Instrutor:" />
                                <TextField fx:id="campoNome" promptText="Nome" />
                                <HBox spacing="5.0">
                                    <children>
                                        <TextField fx:id="campoCpf" promptText="CPF" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="campoCref" promptText="CREF" prefWidth="80.0" />
                                    </children>
                                </HBox>
                                <HBox spacing="5.0">
                                    <children>
                                        <TextField fx:id="campoEspecialidade" promptText="Especialidade" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleSalvarInstrutor" text="Salvar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                    <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <children>

                                <VBox spacing="5.0" style="-fx-background-color: #f4f4f4; -fx-padding: 10; -fx-background-radius: 5;">
                                    <children>
                                        <Label text="Alunos Supervisionados">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <HBox spacing="10.0">
                                            <children>
                                                <ListView fx:id="listaAlunosSupervisionados" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <ComboBox fx:id="comboTodosMembros" promptText="Selecionar aluno da academia..." prefWidth="250.0" />
                                                <Button fx:id="btnVincularAluno" mnemonicParsing="false" onAction="#handleVincularAluno" text="Vincular ao Instrutor" disable="true"/>
                                                <Button fx:id="btnRemoverAluno" mnemonicParsing="false" onAction="#handleRemoverAluno" text="Desvincular" disable="true" style="-fx-background-color: #ffcccc; -fx-text-fill: red; -fx-border-color: red; -fx-border-radius: 3;"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="5.0" VBox.vgrow="ALWAYS" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                                    <children>
                                        <Label text="Editor de Treino Personalizado">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label text="Selecione um aluno na lista acima para editar o treino." textFill="#757575" />

                                        <HBox spacing="5.0">
                                            <children>
                                                <TextField fx:id="txtExercicioNome" promptText="Nome do Exercício" HBox.hgrow="ALWAYS" />
                                                <TextField fx:id="txtSeries" promptText="Séries" prefWidth="60.0" />
                                                <TextField fx:id="txtReps" promptText="Reps" prefWidth="60.0" />
                                                <Button fx:id="btnAddExercicio" onAction="#handleAddExercicio" text="+" disable="true"/>
                                            </children>
                                        </HBox>

                                        <TextArea fx:id="areaFichaPreview" editable="false" promptText="Os exercícios adicionados aparecerão aqui..." VBox.vgrow="ALWAYS" />

                                        <Button fx:id="btnSalvarFicha" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSalvarFichaPersonalizada" text="💾 Salvar Ficha no Aluno" disable="true" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
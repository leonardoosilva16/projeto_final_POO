<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.academia.controller.PlanosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Tabela de Planos e Preços">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <TableView fx:id="tabelaPlanos" prefHeight="300.0" prefWidth="500.0">
        <columns>
            <TableColumn fx:id="colunaNome" prefWidth="350.0" text="Modalidade / Plano"/>
            <TableColumn fx:id="colunaPreco" prefWidth="120.0" text="Mensalidade (R$)"/>
        </columns>
    </TableView>

</VBox>
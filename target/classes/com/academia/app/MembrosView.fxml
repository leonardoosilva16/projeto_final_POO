<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.academia.controller.MembrosControler">
    <children>
        <SplitPane dividerPositions="0.6" layoutX="14.0" layoutY="14.0" prefHeight="500.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <children>
                                <Label text="Lista de Membros">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tabelaMembros" prefHeight="350.0" prefWidth="200.0">
                                    <columns>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="btnRemoverMembro" mnemonicParsing="false" onAction="#handleRemoverMembro" text="Excluir Membro" disable="true" style="-fx-background-color: #ffcccc; -fx-text-fill: red; -fx-border-color: red; -fx-border-radius: 3;" />
                                    </children>
                                </HBox>

                                <Label text="Novo Membro:" />
                                <HBox spacing="5.0">
                                    <children>
                                        <TextField fx:id="campoNome" promptText="Nome" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="campoCpf" promptText="CPF" prefWidth="120.0" />
                                    </children>
                                </HBox>
                                <HBox spacing="5.0">
                                    <children>
                                        <ComboBox fx:id="comboPlanos" promptText="Selecione o Plano" prefWidth="250.0" />
                                        <Button mnemonicParsing="false" onAction="#handleSalvarMembro" text="Cadastrar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                    <children>
                        <VBox spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                            <children>
                                <Label text="Detalhes do Membro">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>

                                <VBox style="-fx-background-color: #e0e0e0; -fx-padding: 10; -fx-background-radius: 5;">
                                    <children>
                                        <Label text="Matrícula &amp; Plano">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblPlanoAtual" text="Plano: Nenhum" />
                                        <Label fx:id="lblVencimento" text="Vence em: --/--/--" />
                                        <Button fx:id="btnRenovar" mnemonicParsing="false" onAction="#handleRenovarMatricula" text="Renovar Matrícula" disable="true" style="-fx-margin-top: 5;"/>
                                    </children>
                                </VBox>

                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Ficha de Treino">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <HBox spacing="5.0">
                                            <children>
                                                <ComboBox fx:id="comboTipoTreino" promptText="Tipo de Treino" />
                                                <Button fx:id="btnGerarFicha" mnemonicParsing="false" onAction="#handleGerarFicha" text="Gerar" disable="true"/>
                                            </children>
                                        </HBox>
                                        <TextArea fx:id="areaTreino" editable="false" prefHeight="200.0" prefWidth="200.0" wrapText="true" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>
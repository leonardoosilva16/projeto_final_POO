<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.academia.app.MembrosControler">

    <Label text="Gestão de Membros"/>

    <TableView fx:id="tabelaMembros" prefHeight="200"/>

    <HBox spacing="10">
        <TextField fx:id="campoNome" promptText="Nome"/>
        <TextField fx:id="campoCpf" promptText="CPF"/>
        <Button text="Salvar" onAction="#handleSalvarMembro"/>
    </HBox>

</VBox>